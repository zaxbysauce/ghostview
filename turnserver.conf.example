# coturn configuration for GhostView — EXAMPLE / TEMPLATE
#
# Copy this file to `turnserver.conf` (which is gitignored) and fill in
# the REQUIRED fields below before running coturn. Never commit a real
# turnserver.conf; the credential fields are secrets.
#
# Required edits:
#   1. Replace <REQUIRED_REALM> with your public domain.
#   2. Replace <REQUIRED_USERNAME> + <REQUIRED_PASSWORD> with a strong
#      randomly-generated credential pair (or switch to short-term creds
#      via use-auth-secret + static-auth-secret — see the commented block
#      further down for the Phase 2 HMAC rotation setup).
#   3. Set `external-ip` to your server's public IP if behind NAT.
#   4. (Optional) Enable TURNS by pointing `cert`/`pkey` at real TLS
#      certificates — required if your network blocks UDP 3478.
#
# The `denied-peer-ip` ranges block TURN from relaying to private subnets,
# preventing the relay from being abused to reach internal services.

listening-port=3478
tls-listening-port=5349

# TURNS (TLS-wrapped TURN) — uncomment and point at real certs.
# Recommended for corporate firewalls that block plain UDP 3478.
# cert=/etc/coturn/certs/cert.pem
# pkey=/etc/coturn/certs/key.pem
# cipher-list=ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20

# Public domain/realm — change for your deployment.
realm=<REQUIRED_REALM>
server-name=<REQUIRED_REALM>

# --- Credentials ---------------------------------------------------------
#
# Option A (Phase 1 default): long-term credential.
# Generate a random password and put it here. Must match the creds the
# GhostView app uses in its ICE server config.
lt-cred-mech
user=<REQUIRED_USERNAME>:<REQUIRED_PASSWORD>
#
# Option B (Phase 2 roadmap): short-term HMAC credentials via
# draft-uberti-rtcweb-turn-rest. The signaling server would issue
# time-limited creds to each session. Not yet wired in Phase 1.
# use-auth-secret
# static-auth-secret=<RANDOM_64_CHAR_SECRET>
# -------------------------------------------------------------------------

# Resource limits.
total-quota=100
stale-nonce=600

# Security: fingerprinting and anti-loopback rules.
fingerprint
no-multicast-peers
no-loopback-peers

# Block relay to RFC1918 private ranges and other reserved blocks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.0.2.0-192.0.2.255
denied-peer-ip=192.88.99.0-192.88.99.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=198.51.100.0-198.51.100.255
denied-peer-ip=203.0.113.0-203.0.113.255
denied-peer-ip=240.0.0.0-255.255.255.255

# If behind NAT (common on a VPS with a single public IP), set this:
# external-ip=203.0.113.45

# Log to stdout for docker.
no-stdout-log=false
log-file=stdout
simple-log
