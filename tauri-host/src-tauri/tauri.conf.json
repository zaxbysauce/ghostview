{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GhostView Pro",
  "version": "0.1.0",
  "identifier": "com.ghostview.pro",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GhostView Pro",
        "width": 420,
        "height": 600,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws: wss: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
